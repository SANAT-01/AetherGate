DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=1

POSTGRES_DB=aethergate
POSTGRES_USER=aethergate
POSTGRES_PASSWORD=aethergate
DATABASE_URL=postgres://aethergate:aethergate@db:5432/aethergate

REDIS_URL=redis://redis:6379/0
IP_RATE_LIMIT_PER_MINUTE=300

PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=changeme

FREELLMAPI_BASE_URL=https://llmapi.sanattudu.tech
FREELLMAPI_TOKEN=changeme

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=changeme

# Used by `manage.py createsuperuser --noinput` to auto-provision the Django
# admin login without an interactive prompt every time the DB is reset.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme
